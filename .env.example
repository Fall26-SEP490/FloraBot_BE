POSTGRES_PASSWORD=local-florabot-only
DATABASE_URL=Host=localhost;Port=55436;Database=florabot;Username=florabot;Password=local-florabot-only
VALKEY_URL=localhost:56379
RABBITMQ_PASSWORD=local-florabot-only
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=55672
RABBITMQ_USER=florabot
JWT_SIGNING_KEY=
# Gateway and API must share JWT_SIGNING_KEY; never use independent ephemeral keys behind YARP.
API_UPSTREAM_URL=http://127.0.0.1:5080
GATEWAY_REQUESTS_PER_MINUTE=600
# Explicit immediate Caddy proxy IPs, comma-separated. Empty means forwarded IP headers are untrusted.
TRUSTED_PROXY_IPS=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Internal .NET -> FastAPI credential, separate from customer/device tokens.
AI_SERVICE_TOKEN=
AI_SERVICE_URL=http://ai:8000
AI_CACHE_VERSION=1
CLOUDINARY_URL=
BREVO_API_KEY=
# Opt in after configuring recipients/provider. Disabled consumes events without sending or automatic replay.
# GoogleSmtp is Development-only, uses smtp.gmail.com:587 with mandatory STARTTLS.
EMAIL_PROVIDER=Disabled
MEMBER_WEB_URL=http://localhost:8088
EMAIL_SENDER=
GOOGLE_SMTP_APP_PASSWORD=
SMS_WEBHOOK_URL=
SMS_API_TOKEN=
# Only honored in Development; never enable for a publicly accessible kiosk.
DEV_OTP=false

# Exact HTTPS origins for a production portal; local origins are allowed only in Development/Testing.
ALLOWED_ORIGINS=
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30

# Enable only after provisioning broker credentials and applying runtime migrations.
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=58883
MQTT_CLIENT_ID=florabot-local-api
MQTT_CREDENTIALS_FILE=infra/secrets/mqtt/backend.json
MQTT_CA_FILE=infra/secrets/mqtt/broker/ca.crt

# Public product images only. Never expose the API secret to frontend apps.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
