---
title: FloraBot ERD tổng quan v3.1 (MVP, chỉ cột khóa) — 22 bảng / 7 service (nét liền = FK trong service, nét đứt = tham chiếu logic khác service; bảng cap.published/received do CAP tự sinh, không tính)
---
erDiagram
  gift_surveys["gift_surveys (ai)"] {
    uuid id PK
    uuid customer_id FK
    uuid kiosk_id FK "NOT NULL"
    uuid selected_product_id FK
    uuid purchased_order_id FK
  }
  flower_products["flower_products (catalog)"] {
    uuid id PK
    uuid seller_id FK "NOT NULL"
  }
  sellers["sellers (identity)"] {
    uuid id PK
    uuid package_id FK
  }
  subscription_packages["subscription_packages (identity)"] {
    uuid id PK
    text name UK "NOT NULL"
  }
  subscriptions["subscriptions (identity)"] {
    uuid id PK
    uuid seller_id FK "NOT NULL"
    uuid package_id FK "NOT NULL"
    uuid payment_id FK
  }
  users["users (identity)"] {
    uuid id PK
    text email UK
    text phone UK
    uuid seller_id FK
  }
  accessories["accessories (kiosk-ops)"] {
    uuid id PK
    uuid seller_id FK "NOT NULL"
    uuid kiosk_id FK "NOT NULL"
  }
  bouquets["bouquets (kiosk-ops)"] {
    uuid id PK
    uuid product_id FK "NOT NULL"
    uuid seller_id FK "NOT NULL"
    text qr_code UK "NOT NULL"
  }
  inventory_logs["inventory_logs (kiosk-ops)"] {
    uuid id PK
    bigint seq UK "NOT NULL"
    uuid bouquet_id FK "NOT NULL"
    uuid slot_id FK "NOT NULL"
    uuid order_id FK
    uuid performed_by FK
  }
  kiosks["kiosks (kiosk-ops)"] {
    uuid id PK
    text code UK "NOT NULL"
    text hardware_id UK "NOT NULL"
    text mqtt_client_id UK "NOT NULL"
  }
  slot_assignments["slot_assignments (kiosk-ops)"] {
    uuid id PK
    uuid slot_id FK,UK "NOT NULL"
    uuid seller_id FK "NOT NULL"
    uuid assigned_by FK "NOT NULL"
  }
  slots["slots (kiosk-ops)"] {
    uuid id PK
    uuid kiosk_id FK "NOT NULL"
    uuid current_seller_id FK
    uuid bouquet_id FK,UK
    uuid hold_order_id FK
  }
  system_settings["system_settings (kiosk-ops)"] {
    text key PK
    uuid updated_by FK
  }
  unlock_tokens["unlock_tokens (kiosk-ops)"] {
    uuid id PK
    uuid kiosk_id FK "NOT NULL"
    uuid slot_id FK,UK "NOT NULL"
    uuid order_id FK
    uuid issued_to_user_id FK
    text token_hash UK "NOT NULL"
    uuid cmd_id UK "NOT NULL"
  }
  attachments["attachments (notify-media)"] {
    uuid id PK
    uuid uploaded_by FK
  }
  audit_logs["audit_logs (notify-media)"] {
    bigint id PK
    uuid actor_id FK
  }
  disputes["disputes (ordering)"] {
    uuid id PK
    uuid order_id FK,UK
    uuid kiosk_id FK "NOT NULL"
    uuid slot_id FK
    uuid reported_by FK
    uuid decided_by FK
  }
  order_items["order_items (ordering)"] {
    uuid id PK
    uuid order_id FK "NOT NULL"
    uuid bouquet_id FK,UK
    uuid accessory_id FK
    uuid slot_id FK
  }
  orders["orders (ordering)"] {
    uuid id PK
    text order_code UK "NOT NULL"
    uuid customer_id FK
    uuid seller_id FK "NOT NULL"
    uuid kiosk_id FK "NOT NULL"
    text tracking_token UK "NOT NULL"
  }
  ledger_entries["ledger_entries (payment)"] {
    uuid id PK
    uuid seller_id FK
  }
  payments["payments (payment)"] {
    uuid id PK
    uuid checkout_id FK,UK
    uuid order_id FK
    uuid subscription_id FK
    uuid parent_payment_id FK
    text idempotency_key UK "NOT NULL"
    uuid approved_by FK
  }
  withdrawal_requests["withdrawal_requests (payment)"] {
    uuid id PK
    uuid seller_id FK,UK "NOT NULL"
    uuid approved_by FK
  }
